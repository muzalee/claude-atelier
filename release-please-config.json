{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": true,
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore(main): release ${branch}",
  "packages": {
    "plugins/atelier": {
      "package-name": "atelier",
      "component": "atelier",
      "extra-files": [
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "/.claude-plugin/marketplace.json", "jsonpath": "$.plugins[?(@.name=='atelier')].version" }
      ]
    },
    "plugins/atelier-typescript": {
      "package-name": "atelier-typescript",
      "component": "atelier-typescript",
      "extra-files": [
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "/.claude-plugin/marketplace.json", "jsonpath": "$.plugins[?(@.name=='atelier-typescript')].version" }
      ]
    },
    "plugins/atelier-flutter": {
      "package-name": "atelier-flutter",
      "component": "atelier-flutter",
      "extra-files": [
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "/.claude-plugin/marketplace.json", "jsonpath": "$.plugins[?(@.name=='atelier-flutter')].version" }
      ]
    }
  }
}
